<section class="bg-gradient-to-r from-black to-[#221a04]">
  <div class="max-w-[1440px] mx-auto min-h-screen flex flex-col lg:flex-row items-center justify-between py-24 px-6 gap-12">

    <!-- Left Image -->
    <div class="lg:w-[40%] w-full flex justify-center">
      <img
        src="{{ 'lamp.png' | asset_url }}"
        alt="wall lamp"
        width=""
        height=""
        class="object-cover w-full max-w-[500px]" />
    </div>

    <!-- Right Content -->
    <div class="lg:w-[55%] w-full text-white" x-data="{ openItem: 1 }">
      <h2 class="max-w-[480px] font-['Times_New_Roman'] font-normal text-[40px] leading-[1] tracking-normal text-white mb-10">
        Why should you choose us as your partner
      </h2>

      <!-- Accordion -->
      <div class="space-y-6">

        <!-- Item 1 -->
        <div>
          <button class="flex items-center justify-between w-full text-left" @click="openItem = openItem === 1 ? null : 1">
            <span class="font-Montserrat font-semibold text-[20px] leading-[1] tracking-normal text-white">Remote Light Control</span>
            <div :class="openItem === 1 ? 'rotate-180' : 'rotate-0'" class="transition-transform duration-300">
              {% render 'icon-dropdown' %}
            </div>
          </button>
          <div x-show="openItem === 1" x-transition>
            <p class="mt-4 max-w-[552px] font-Montserrat font-normal text-[16px] leading-[1.5] tracking-wide text-white">
              It's easier to control brightness with the remote control lamp, so you don't have to go to the light switch.
            </p>
          </div>
        </div>

        <!-- Item 2 -->
        <div>
          <button class="flex items-center justify-between w-full text-left" @click="openItem = openItem === 2 ? null : 2">
            <span class="font-Montserrat font-semibold text-[20px] leading-[1] tracking-normal text-white">Latest and modern design</span>
            <div :class="openItem === 2 ? 'rotate-180' : 'rotate-0'" class="transition-transform duration-300">
              {% render 'icon-dropdown' %}
            </div>
          </button>
          <div x-show="openItem === 2" x-transition>
            <p class="mt-4 max-w-[552px] font-Montserrat font-normal text-[16px] leading-[1.5] tracking-wide text-white">
              Our products feature a sleek and modern aesthetic, crafted with precision and contemporary style to enhance your space.
            </p>
          </div>
        </div>

        <!-- Item 3 -->
        <div>
          <button class="flex items-center justify-between w-full text-left" @click="openItem = openItem === 3 ? null : 3">
            <span class="font-Montserrat font-semibold text-[20px] leading-[1] tracking-normal text-white">Saving electricity and quality control</span>
            <div :class="openItem === 3 ? 'rotate-180' : 'rotate-0'" class="transition-transform duration-300">
              {% render 'icon-dropdown' %}
            </div>
          </button>
          <div x-show="openItem === 3" x-transition>
            <p class="mt-4 max-w-[552px] font-Montserrat font-normal text-[16px] leading-[1.5] tracking-wide text-white">
              Our lamps are engineered to be energy-efficient while maintaining superior quality and performance.
            </p>
          </div>
        </div>
      </div>

      <!-- CTA Button -->
      <div class="mt-20">
        <a href="#" class="inline-block bg-white text-[#111111] font-Montserrat font-bold text-[18px] leading-[1] px-8 py-3 rounded-full">
          SHOP NOW
        </a>
      </div>
    </div>
  </div>
</section>