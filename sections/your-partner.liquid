<section class="bg-gradient-to-r from-black to-[#221a04]">
  <div class="max-w-[1440px] mx-auto min-h-screen flex flex-col lg:flex-row items-center justify-between py-24 px-6 gap-12">

    <!-- Left Image -->
    <div class="lg:w-[40%] w-full flex justify-center">
      <img
        src="{{ section.settings.image |  image_url: width: 800 }}"
        alt="{{ section.settings.image_alt }}"
        width=""
        height=""
        class="object-cover w-full max-w-[500px]" />
    </div>

    <!-- Right Content -->
    <div class="lg:w-[55%] w-full text-white" x-data="{ openItem: 1 }">
      <h2 class="max-w-[480px] font-['Times_New_Roman'] font-normal text-[40px] leading-[1] tracking-normal text-white mb-10">
        {{ section.settings.heading }}
      </h2>

      <!-- Accordion -->
      <div class="space-y-6">
        {% for block in section.blocks %}
          <div>
            <button class="flex items-center justify-between w-full text-left" @click="openItem = openItem === {{ forloop.index }} ? null : {{ forloop.index }}">
              <span class="font-Montserrat font-semibold text-[20px] leading-[1] tracking-normal text-white">{{ block.settings.title }}</span>
              <div :class="openItem === {{ forloop.index }} ? 'rotate-180' : 'rotate-0'" class="transition-transform duration-300">
                {% render 'icon-dropdown' %}
              </div>
            </button>
            <div x-show="openItem === {{ forloop.index }}" x-transition>
              <p class="mt-4 max-w-[552px] font-Montserrat font-normal text-[16px] leading-[1.5] tracking-wide text-white">
                {{ block.settings.description }}
              </p>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- CTA Button -->
      <div class="mt-20">
        <a href="{{ section.settings.button_link }}" class="inline-block bg-white text-[#111111] font-Montserrat font-bold text-[18px] leading-[1] px-8 py-3 rounded-full">
          {{ section.settings.button_text }}
        </a>
      </div>
    </div>
  </div>
</section>


{% schema %}
  {
    "name": "Why Choose Us Accordion",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Left Image"
      },
      {
        "type": "text",
        "id": "image_alt",
        "label": "Image Alt Text",
        "default": "wall lamp"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Main Heading",
        "default": "Why should you choose us as your partner"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link",
        "default": "/collections/all"
      }
    ],
    "blocks": [
      {
        "type": "accordion_item",
        "name": "Accordion Item",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Accordion Title",
            "default": "Remote Light Control"
          },
          {
            "type": "textarea",
            "id": "description",
            "label": "Accordion Description",
            "default": "It's easier to control brightness with the remote control lamp, so you don't have to go to the light switch."
          }
        ]
      }
    ],
    "max_blocks": 6,
    "presets": [
      {
        "name": "Why Choose Us Accordion",
        "category": "Custom Sections",
        "blocks": [
          {
            "type": "accordion_item",
            "settings": {
              "title": "Remote Light Control",
              "description": "It's easier to control brightness with the remote control lamp, so you don't have to go to the light switch."
            }
          },
          {
            "type": "accordion_item",
            "settings": {
              "title": "Latest and modern design",
              "description": "Our products feature a sleek and modern aesthetic, crafted with precision and contemporary style to enhance your space."
            }
          },
          {
            "type": "accordion_item",
            "settings": {
              "title": "Saving electricity and quality control",
              "description": "Our lamps are engineered to be energy-efficient while maintaining superior quality and performance."
            }
          }
        ]
      }
    ]
  }
{% endschema %}