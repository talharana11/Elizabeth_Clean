<div class="container px-6 py-24 mx-auto">
  <div class="relative">
    <!-- Swiper Container -->
    <div class="swiper myReviewSwiper">
      <div class="swiper-wrapper">

        <!-- 1. Rating Summary Card -->
        <div class="flex justify-center swiper-slide">
          <div class="bg-white w-[300px] md:w-[340px] h-[240px] flex flex-col items-center justify-center text-center p-6 rounded-lg shadow-md">
            <h3 class="mb-3 text-xl font-semibold text-black">Excellent</h3>
            <div class="flex mb-2 text-green-600">
              {% for i in (1..5) %}
                {% render 'icon-star' %}
              {% endfor %}
            </div>
            <p class="text-sm text-gray-800">
              Based on
              <span class="font-bold underline">456 reviews</span>
            </p>
            <div class="flex items-center justify-center gap-1 mt-2 font-semibold text-green-600">
              {% render 'icon-star' %}
              <span class="text-black">Trustpilot</span>
            </div>
          </div>
        </div>

        <!-- 2. Review Card -->
        {% for block in section.blocks %}
          <div class="flex justify-center swiper-slide">
            <div class="bg-white w-[300px] md:w-[340px] h-[240px] p-6 rounded-lg shadow-md flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <div class="flex text-green-600">
                    {% for i in (1..5) %}
                      {% render 'icon-star' %}
                    {% endfor %}
                  </div>
                  <p class="text-xs text-gray-700">{{ block.settings.days_ago }}</p>
                </div>
                <h4 class="mb-1 text-lg font-semibold text-black">{{ block.settings.title }}</h4>
                <p class="text-sm leading-snug text-gray-800">{{ block.settings.text }}</p>
              </div>
              <p class="mt-3 text-sm font-semibold text-black">{{ block.settings.author }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Arrows with Shopify icons -->
    <div class="absolute inset-y-0 left-0 right-0 flex items-center justify-between">
      <button class="w-4 h-4 p-4 -ml-16 text-white bg-black border-2 border-white rounded-full swiper-button-prev">
        {% render 'icon-chevron-left' %}
      </button>

      <button class="w-4 h-4 p-4 -mr-16 text-white bg-black border-2 border-white rounded-full swiper-button-next">
        {% render 'icon-chevron-right' %}
      </button>
    </div>

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    new Swiper(".myReviewSwiper", {
      slidesPerView: 4,
      spaceBetween: 10,
      loop: true,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      breakpoints: {
        0: { slidesPerView: 1.1, spaceBetween: 6 },
        640: { slidesPerView: 2, spaceBetween: 8 },
        1024: { slidesPerView: 3, spaceBetween: 10 },
        1280: { slidesPerView: 4, spaceBetween: 12 },
      },
    });
  });
</script>

{% schema %}
  {
    "name": "Review Slider",
    "settings": [],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "text",
            "id": "days_ago",
            "label": "Days Ago",
            "default": "2 days ago"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Review Title",
            "default": "Best on the market"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Review Text",
            "default": "I love this product because the support is great. Please keep it up!"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author",
            "default": "Worldtraveler"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Review Slider",
        "category": "Testimonials"
      }
    ]
  }
{% endschema %}