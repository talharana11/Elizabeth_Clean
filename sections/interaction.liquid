<section class="relative w-full min-h-screen bg-gradient-to-r from-[#261e05] to-[#010100] text-white flex items-center justify-center py-12 px-6">
  <div class="max-w-[1440px] w-full">
    <!-- first -->
    <div class="flex justify-between">
      <div class="w-1/2">
        <div class="max-w-[500px]">
          <h1 class=" font-['Times_New_Roman'] font-normal text-[56px] leading-[1.1] tracking-normal">
            Passionate About Intelligent Interaction
          </h1>
        </div>
      </div>

      <div class="flex justify-end w-1/2 text-right">
        <div class="max-w-[370px]">
          <p class="font-Montserrat font-normal text-[16px] leading-[1.6] tracking-normal">
            Discover the perfect lighting for every corner of your home with KL Home's stylish, versatile, and energy-efficient products.
          </p>

          <a href="#" class="inline-block px-[43px] py-[9px] font-Montserrat font-semibold text-black bg-white rounded-full mt-18">
            SHOP NOW
          </a>
        </div>
      </div>
    </div>
    <!-- second -->
    <div class="">
      <div class="relative mt-12">
        <img
          src="{{ 'double image.png' |  asset_url }}"
          alt="light"
          width=""
          height=""
          class="object-cover w-full h-auto">

        <div class="absolute bottom-[8%]">
          <p class="font-['Times_New_Roman'] font-normal text-[32px] leading-[1] text-white max-w-[570px] tracking-wider">
            Illuminate Your World with Effortless Style and Sustainable Lighting Solutions.</p>
        </div>

        <div class="absolute top-[10%] right-[10%]">
          <h2 class="font-Montserrat font-extrabold text-[93px] leading-[0.74] tracking-wide text-white">14500+</h2>
          <p class="mt-4 font-Montserrat font-semibold text-[20px] text-white leading-normal tracking-wide">Satisfied customers at KL Home®</p>
          <span class="flex justify-center mt-5 text-yellow-400">
            {% for i in (1..5) %}
              {% render 'icon-star' %}
            {% endfor %}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>