<section class="relative w-full min-h-screen bg-gradient-to-r from-[#261e05] to-[#010100] text-white flex items-center justify-center py-12 px-6">
  <div class="max-w-[1440px] w-full">
    <!-- first -->
    <div class="flex justify-between">
      <div class="w-1/2">
        <div class="max-w-[500px]">
          <h1 class=" font-['Times_New_Roman'] font-normal text-[56px] leading-[1.1] tracking-normal">
            {{ section.settings.heading }}
          </h1>
        </div>
      </div>

      <div class="flex justify-end w-1/2 text-right">
        <div class="max-w-[370px]">
          <p class="font-Montserrat font-normal text-[16px] leading-[1.6] tracking-normal">
            {{ section.settings.paragraph }}
          </p>

          <a href="{{ section.settings.button_link }}" class="inline-block px-[43px] py-[9px] font-Montserrat font-semibold text-black bg-white rounded-full mt-18">
            {{ section.settings.button_text }}
          </a>
        </div>
      </div>
    </div>
    <!-- second -->
    <div class="">
      <div class="relative mt-12">
        <img
          src="{{ section.settings.main_image | image_url }}"
          alt="light"
          width=""
          height=""
          class="object-cover w-full h-auto">

        <div class="absolute bottom-[8%]">
          <p class="font-['Times_New_Roman'] font-normal text-[32px] leading-[1] text-white max-w-[570px] tracking-wider">
            {{ section.settings.image_overlay_text }}</p>
        </div>

        <div class="absolute top-[10%] right-[10%]">
          <h2 class="font-Montserrat font-extrabold text-[93px] leading-[0.74] tracking-wide text-white">{{ section.settings.customer_count }}</h2>
          <p class="mt-4 font-Montserrat font-semibold text-[20px] text-white leading-normal tracking-wide">{{ section.settings.customer_stat_label }}</p>
          <span class="flex justify-center mt-5 text-yellow-400">
            {% for i in (1..5) %}
              {% render 'icon-star' %}
            {% endfor %}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>


{% schema %}
  {
    "name": "Hero Banner - Lighting",
    "settings": [
      {
        "type": "header",
        "content": "Top Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Main Heading",
        "default": "Passionate About Intelligent Interaction"
      },
      {
        "type": "textarea",
        "id": "paragraph",
        "label": "Top Right Paragraph",
        "default": "Discover the perfect lighting for every corner of your home with KL Home's stylish, versatile, and energy-efficient products."
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "header",
        "content": "Image and Overlays"
      },
      {
        "type": "image_picker",
        "id": "main_image",
        "label": "Main Banner Image",
        "info": "Image will span the width of the container."
      },
      {
        "type": "text",
        "id": "image_overlay_text",
        "label": "Image Overlay Text",
        "default": "Illuminate Your World with Effortless Style and Sustainable Lighting Solutions."
      },
      {
        "type": "header",
        "content": "Customer Stats"
      },
      {
        "type": "text",
        "id": "customer_count",
        "label": "Customer Count Number",
        "default": "14500+"
      },
      {
        "type": "text",
        "id": "customer_stat_label",
        "label": "Customer Stat Label",
        "default": "Satisfied customers at KL Home®"
      },
      {
        "type": "range",
        "id": "star_rating",
        "min": 0,
        "max": 5,
        "step": 1,
        "label": "Star Rating (Visual Only)",
        "default": 5
      }
    ],
    "presets": [
      {
        "name": "Hero Banner - Lighting"
      }
    ]
  }
{% endschema %}