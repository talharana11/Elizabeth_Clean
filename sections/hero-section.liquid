<div class="relative min-h-screen mx-auto max-w-1550">
  <div class="relative w-full">
    <!-- Hero Background Image -->
    {% if section.settings.hero_image != blank %}
      <img
        src="{{ section.settings.hero_image | image_url: width: 1320 }}"
        alt="{{ section.settings.hero_image.alt | escape }}"
        loading="eager"
        width=""
        height=""
        class="object-cover object-center w-full min-h-screen text-white -mt-28 px-18">
    {% endif %}


    <!-- Hero Text Content -->
    <div class="absolute top-92 left-24">
      <h2 class="max-w-[350px] text-xl font-semibold text-white leading-normal mb-2">
        {{ section.settings.hero_subheading }}
      </h2>

      <div class="flex flex-col items-start gap-8 lg:flex-row">
        <!-- Left Column - Text Content -->
        <div>
          <h1 class="w-[760px] text-[80px] font-light text-white leading-[1.075] mb-6">
            {{ section.settings.hero_heading }}
          </h1>

          <p class="w-[450px] text-white text-[18px] font-light mb-8 leading-normal">
            {{ section.settings.hero_description }}
          </p>

          <!-- CTA Button -->
          <div class="mb-10">
            <a href="{{ section.settings.btn_link }}" class="inline-block  border-2 uppercase bg-[#FFFFFF26] text-white font-medium text-[20px] py-3 px-14 rounded-xl shadow-md">
              {{ section.settings.btn_text }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Customer Section -->
  <div class="absolute right-10 top-[60vh] md:top-[92vh] md:w-sm md:right-15">
    <div class="relative w-[500px] md:w-[350px]">
      {% if section.settings.customer_bg %}
        <img
          src="{{ section.settings.customer_bg | image_url: width: 400 }}"
          alt="Customer Background"
          width=""
          height=""
          loading="eager"
          class="w-[400px] h-[300px] object-contain md:w-[350px] md:h-[220px]">
      {% endif %}

      <div class="absolute inset-0 flex ml-4">
        <div class="flex flex-col justify-center mb-2 ml-2 md:mb-0 md:my-2">
          <div class="flex">
            {% for block in section.blocks %}
              {% if block.settings.customer_image %}
                <img
                  src="{{ 'block.settings.customer_image' | image_url: width: 15 }}"
                  alt="Customer {{ forloop.index }}"
                  width=""
                  height=""
                  loading="eager"
                  class="object-cover -ml-3 rounded-full w-15 h-15">
              {% else %}
                <p>No image selected</p>
              {% endif %}
            {% endfor %}
          </div>
          <div>
            <h2 class="text-[52px] font-bold text-white leading-normal">{{ section.settings.customer_count }}</h2>
            <h3 class="text-[20px] font-medium text-white">
              <span class="block tracking-wider leading">{{ section.settings.customer_text_1 }}</span>
              <span class="flex justify-between mt-1 tracking-wider md:mt-0">
                {{ section.settings.customer_text_2 }}
                <span class="flex text-yellow-400">
                  {% for i in (1..5) %}
                    {% render 'icon-star' %}
                  {% endfor %}
                </span>
              </span>
            </h3>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Hero Section & Customers",
    "settings": [
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Hero Background Image"
      },
      {
        "type": "text",
        "id": "hero_subheading",
        "label": "Subheading",
        "default": "Your specialist in wireless lighting"
      },
      {
        "type": "text",
        "id": "hero_heading",
        "label": "Heading",
        "default": "Atmospheric Light, Simple and Wireless"
      },
      {
        "type": "textarea",
        "id": "hero_description",
        "label": "Description",
        "default": "Discover KL Home's innovative, wireless lighting solutions that blend modern design with energy efficiency. Easy to install, rechargeable, and stylish, our lights enhance your space with effortless elegance and long-lasting performance."
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button Text",
        "default": "SHOP NOW"
      },
      {
        "type": "url",
        "id": "btn_link",
        "label": "Button Link"
      },
      {
        "type": "image_picker",
        "id": "customer_bg",
        "label": "Customer Background Image"
      },
      {
        "type": "text",
        "id": "customer_count",
        "label": "Customer Count",
        "default": "14500+"
      },
      {
        "type": "text",
        "id": "customer_text_1",
        "label": "Customer Text line 1",
        "default": "Satisfied Customers at KL"
      },
      {
        "type": "text",
        "id": "customer_text_2",
        "label": "Customer Text Line 2",
        "default": "Home®"
      }
    ],
    "blocks": [
      {
        "type": "customer_image",
        "name": "Customer Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "customer_image",
            "label": "Customer Image"
          }
        ]
      }
    ],
    "max_blocks": 4,
    "presets": [
      {
        "name": "Hero Section & Customers",
        "category": "Hero"
      }
    ]
  }
{% endschema %}