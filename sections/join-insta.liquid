<section class="bg-gradient-to-r from-black to-[#221a04] py-20">
  <div class="max-w-[1440px] mx-auto px-6">

    <!-- Heading -->
    <h2 class="text-white font-['Times_New_Roman'] text-[40px] font-normal mb-10 leading-[1.6] tracking-normal">
      Join #klhome
    </h2>

    <!-- Instagram Grid -->
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-5">
      <!-- Single Card -->
      <div class="rounded-lg aspect-[3/4] flex items-center justify-center relative overflow-hidden cursor-pointer">
        <img
          src="{{ 'light-1.png' |  asset_url }}"
          alt="Instagram Post"
          width=""
          height=""
          class="absolute inset-0 object-cover w-full h-full rounded-lg">
        <div class="absolute inset-0 flex items-center justify-center transition-opacity duration-300 opacity-0 bg-black/40 hover:opacity-100">
          {% render 'icon-insta' %}
        </div>
      </div>

