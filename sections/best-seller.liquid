<div class="container mx-auto mt-10">
  <div class="w-full">
    <h1 class="text-white text-[40px] font-light font-['Times_New_Roman'] mb-10">
      {{ section.settings.section_title }}
    </h1>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-4 gap-9 m-4">

    <div class="w-full">
      <a class="block relative rounded overflow-hidden">
        <img
          src="{{ section.settings.product_1_image | file_url }}"
          alt="ecommerce"
          width=""
          height=""
          class="xl:w-[350px] xl:h-[400px] w-[311px] h-[350px] object-center object-fill">
      </a>
      <div class="mt-4 flex flex-col items-center justify-center mb-10">
        <div class="flex gap-2 py-2">
          <div class="w-5 h-5 bg-black rounded-full border border-white"></div>
          <div class="w-5 h-5 rounded-full border border-white bg-white"></div>
        </div>
        <h1 class="text-white text-xl tracking-widest">{{ section.settings.product_1_title }}</h1>
        <h3 class="text-[16px] font-semibold font-['Montserrat'] leading-normal py-1 text-[#838383]">{{ section.settings.product_1_description }}</h3>
        <div class="flex gap-4 py-1">
          <span class="flex text-yellow-400 text-sm">
            {% for j in (1..5) %}
              {% render 'icon-star' %}
            {% endfor %}
          </span>
          <p class="text-[16px] text-white">{{ section.settings.product_1_reviews }}</p>
        </div>
        <p class="mt-1 text-white text-2xl leading-normal font-bold">{{ section.settings.product_1_price }}</p>
