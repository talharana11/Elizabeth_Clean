<div class="container mx-auto flex px-5 py-24 items-center justify-center flex-col">
  <div class="text-center lg:w-2/3 w-full">
    <h1 class="text-[40px] mb-4 font-light text-white font-['Times_New_Roman']">{{ section.settings.main_heading }}</h1>
    <p class="leading-normal text-[16px] font-normal text-white mb-10">{{ section.settings.description_text }}</p>
  </div>
  <div class="w-full max-w-[1200px]">
    <img
      src="{{ section.settings.video_image | file_url }}"
      alt="Video"
      width=""
      height=""
      class="w-full h-[650px] lg:w-2/6 md:w-3/6 object-center object-contain rounded">
  </div>
</div>


{% schema %}
  {
    "name": "Installation with KL Home",
    "settings": [
      {
        "type": "text",
        "label": "Main Heading",
        "id": "main_heading",
        "default": "Effortless Installation with KL Home"
      },
      {
        "type": "textarea",
        "label": "Description Text",
        "id": "description_text",
        "default": "Our lights are designed to simplify your life. Watch how easy it is to install and enjoy our versatile, stylish lighting solutions in just minutes."
      },
      {
        "type": "image_picker",
        "label": "Video Image",
        "id": "video_image"
      }
    ]
  }
{% endschema %}