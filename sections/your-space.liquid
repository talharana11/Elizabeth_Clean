<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital, wght@0, 100..900;1, 100..900 &display=swap');
</style>

<div class="max-w-[1440px] mx-auto px-6 py-20 mb-6">
  <!-- Make columns stretch to the same height -->
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-stretch">

    <!-- LEFT: fixed match at lg+ -->
    <div class="bg-white rounded-2xl shadow-sm py-6 pl-12 pr-16  h-[600px] flex flex-col justify-center">
      <div class="w-full lg:w-[485px]">
        <h2 class="text-[40px] font-['Times_New_Roman'] font-normal leading-[1.05] mb-8 pr-10">
          {{ section.settings.heading }}
        </h2>
        <p class=" text-black text-[16px] font-normal tracking-wider leading-[1.375] font-Montserrat mb-13">
          {{ section.settings.description }}
        </p>
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="bg-black text-white uppercase font-[Montserrat] text-[18px] font-semibold px-7 py-2.5 rounded-xl leading-none">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT: exact 620 tall stack at lg+ -->
    <div class="grid grid-cols-2 grid-rows-2 gap-6 lg:gap-8 lg:h-[600px]">
      <!-- Tall media (left) -->
      <div class="relative col-span-1 row-span-2">
        <img
          src="{{ section.settings.main_image | file_url }}"
          alt="Lighting Video"
          width=""
          height=""
          class="rounded-2xl w-full h-full lg:h-[600px] object-cover">
        {% if section.settings.show_play_button %}
          <button class="absolute inset-0 flex items-center justify-center w-16 h-16 m-auto text-black transition rounded-full shadow-lg bg-white/85 hover:scale-105">
            ▶
          </button>
        {% endif %}
      </div>

      <!-- Top right image -->
      <div>
        <img
          src="{{ section.settings.top_right_image | file_url }}"
          alt="Light 1"
          width=""
          height=""
          class="rounded-2xl w-full h-[290px] md:h-[300px] lg:h-[295px] object-cover">
      </div>

      <!-- Bottom right image -->
      <div>
        <img
          src="{{ section.settings.bottom_right_image | file_url }}"
          alt="Light 2"
          width=""
          height=""
          class="rounded-2xl w-full h-[290px] md:h-[300px] lg:h-[295px] object-cover">
      </div>
    </div>
  </div>
</div>


{% schema %}
  {
    "name": "Lighting Feature Section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Transform Your Space with Effortless Lighting Solutions"
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Elevate your home with KL Home’s modern, energy-efficient lighting options. Our products are designed for simplicity, offering easy installation, stylish designs, and long-lasting performance."
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button Label",
        "default": "Shop Now"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button Link"
      },
      {
        "type": "image_picker",
        "id": "main_image",
        "label": "Left Tall Image (Video Placeholder)"
      },
      {
        "type": "checkbox",
        "id": "show_play_button",
        "label": "Show Play Button",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "top_right_image",
        "label": "Top Right Image"
      },
      {
        "type": "image_picker",
        "id": "bottom_right_image",
        "label": "Bottom Right Image"
      }
    ],
    "presets": [
      {
        "name": "Lighting Feature Section"
      }
    ]
  }
{% endschema %}